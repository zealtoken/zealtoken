# The deployer key is NOT kept here. It lives encrypted in .keystore.json:
#   npm run key:create
# Everything below is a public address; none of it is secret.

# Optional RPC overrides. The public endpoint is rate-limited and Robinhood's
# own docs say not to use it for production workloads.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- ZealFoundry: all three are IMMUTABLE after deployment ---
RESERVE_SINK=0x...     # multisig that bridges WETH -> native ZEC
LIQUIDITY_SINK=0x...   # wallet that pairs zZEC liquidity
OPS_SINK=0x...         # audits, attestation, infrastructure

# --- ZZEC ---
ZEC_RESERVE_ADDRESS=t1...   # Zcash TRANSPARENT address, published, no setter
ZZEC_OWNER=0x...            # multisig; can pause minting instantly, rotate roles on a 48h timelock
ZZEC_ATTESTOR=0x...         # posts the reserve reading. MUST differ from the minter
ZZEC_MINTER=0x...           # mints against the attested reserve
MAX_ATTESTATION_AGE=129600  # 36h in seconds. Bounded to 1h..7d by the contract

# --- ZealFurnace ---
ZEAL_TOKEN=0x...          # the $ZEAL token, immutable
SWAP_ROUTER=0x...         # Uniswap V3 SwapRouter (exactInput WITH deadline). Verify ABI on testnet. Immutable
FURNACE_IGNITER=0x...     # keeper that calls ignite(); 48h timelock to rotate
