{
  "name": "zeal-reserve-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The operator behind zZEC: turns routed ETH into native ZEC, attests the reserve, mints against it, and honours redemptions.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "status": "tsx src/status.ts",
    "attest": "tsx src/attest.ts",
    "mint": "tsx src/mint.ts",
    "redeem:watch": "tsx src/redeem-watch.ts",
    "sweep": "tsx src/sweep.ts",
    "keys:create": "tsx src/keys.ts",
    "pool": "tsx src/pool.ts",
    "watch:roles": "tsx src/watch-roles.ts",
    "burn": "tsx src/burn.ts",
    "peg": "tsx src/peg.ts",
    "keeper": "tsx src/keeper.ts",
    "lp:exit": "tsx src/lp-exit.ts",
    "lp:collect": "tsx src/lp-collect.ts",
    "desk": "tsx src/fulfill.ts",
    "wrap": "tsx src/wrap.ts",
    "watch:desk": "tsx src/desk-watch.ts",
    "desk:pay": "tsx src/desk-pay.ts",
    "compound": "tsx src/compound.ts",
    "dividends": "tsx src/dividends.ts",
    "withdraw": "tsx src/withdraw.ts",
    "test": "tsx --test src/*.test.ts",
    "replenish": "tsx src/replenish.ts",
    "replenish:session": "tsx src/replenish.ts --execute --daemon --session",
    "replenish:daemon": "tsx src/replenish.ts --execute --daemon",
    "replenish:background": "tsx src/replenish-background.ts",
    "cloud:unlock": "tsx src/cloud-unlock.ts",
    "cloud:finish-burn": "tsx src/cloud-finish-burn.ts",
    "lp:reinvest": "tsx src/lp-reinvest.ts",
    "reserve:prepare": "tsx src/reserve-prepare.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1127.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
