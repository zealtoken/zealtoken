# Robinhood Chain
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ZZEC_ADDRESS=0x...            # Phase 02 deploy

# Role keys live encrypted in ops/.keys (npm run keys:create). Optional:
# ATTESTOR_PASS / MINTER_PASS for unattended runs, or raw ATTESTOR_KEY / MINTER_KEY
# on a host that injects secrets itself.

# Zcash reserve
ZEC_RESERVE_ADDRESS=t1...     # published transparent address
LIGHTWALLETD=https://zec.rocks:443
ZINGO_CLI=/usr/local/bin/zingo-cli
ZINGO_DATA=/path/to/zingo-wallet-dir   # holds the encrypted spending key
REDEEM_LEDGER=./redemptions.json
